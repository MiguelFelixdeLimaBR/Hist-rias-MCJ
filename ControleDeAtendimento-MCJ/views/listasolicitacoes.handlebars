<div class="container">
        <h1>Solicitações pendentes</h1>
        <ul class="list">
            {{#each soli}}
                <li class="list-item">
                    <strong>Nome:</strong> {{discente}}<br>
                    <strong>Matrícula:</strong> {{matricula}}<br>
                    <strong>Título:</strong> {{titulo}}<br>
                    <strong>Causa:</strong> {{causa}}

                    <div class="actions">
                        <form action="/solicitacao/approve/{{id}}?_method=PUT" method="POST">
                            <button type="submit">Aprovar</button>
                        </form>
                        <form action="/solicitacao/reject/{{id}}?_method=PUT" method="POST">
                            <button type="submit">Rejeitar</button>
                        </form>
                    </div>
                </li>
            {{/each}}
        </ul>
            <a class="link" href="/secretaria">Voltar</a>
    </div>
