<div class="container">
        <h1>Solicitações</h1>
        <ul class="list">
            {{#each soli}}
                <li class="list-item">
                    <strong>Nome:</strong> {{discente}}<br>
                    <strong>Matrícula:</strong> {{matricula}}<br>
                    <strong>Título:</strong> {{titulo}}<br>
                    <strong>Causa:</strong> {{causa}}<br>
                    <strong>Status:</strong> {{status}}

                    <div class="actions">
                        <form action="/solitedele/{{id}}?_method=DELETE" method="POST">
                            <button type="submit">Deletar</button>
                        </form>

                        {{#if_eq status 'Pendente'}}
                        <form action="/slcedit/{{id}}" method="GET">
                            <button type="submit">Editar</button>
                        </form>
                        {{/if_eq}}
                    </div>
                </li>
            {{/each}}
            <a class="link" href="/discente">Voltar</a>
        </ul>
    </div>
