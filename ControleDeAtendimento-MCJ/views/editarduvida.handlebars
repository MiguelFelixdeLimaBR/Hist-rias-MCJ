<div class="container form-page">
        <h1>Editar Dúvida</h1>
        <form action="/duvidaedit/{{dvd.id}}?_method=PUT" method="POST">
            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" value="{{dvd.nome}}" required>

            <label for="duvida">Dúvida</label>
            <input type="text" id="duvida" name="duvida" value="{{dvd.duvida}}" required>

            <button type="submit">Salvar edição</button>
        </form>
        <a class="link" href="/discente/listarduvidas2">Voltar</a>
    </div>
