<div class="container form-page">
        <h1>Editar Discente</h1>
        <form action="/discenteedit/{{discente.id}}?_method=PUT" method="POST">
            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" value="{{discente.nome}}" required>

            <label for="idade">Idade</label>
            <input type="number" id="idade" name="idade" value="{{discente.idade}}" required>

            <label for="matricula">Matrícula</label>
            <input type="text" id="matricula" name="matricula" value="{{discente.matricula}}" required>

            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="{{discente.email}}" required>

            <label for="curso">Curso</label>
            <input type="text" id="curso" name="curso" value="{{discente.curso}}" required>

            <button type="submit">Salvar</button>
        </form>
        <a class="link" href="/secretaria">Voltar</a>
    </div>
