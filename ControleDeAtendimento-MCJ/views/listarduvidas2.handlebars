<div class="container">
        <h1>Minhas Dúvidas</h1>
        <ul class="list">
            {{#each duvidas}}
                <li class="list-item">
                    <strong>Nome:</strong> {{nome}}<br>
                    <strong>Dúvida:</strong> {{duvida}}<br>
                    <strong>Resposta:</strong> {{resposta}}<br>
                    <strong>Status:</strong> {{status}}

                    <div class="actions">
                        <form action="/duvidadele/{{id}}?_method=DELETE" method="POST">
                            <button type="submit">Deletar</button>
                        </form>

                        {{#if_eq status 'pendente'}}
                        <form action="/duvidaedit/{{id}}" method="GET">
                            <button type="submit">Editar</button>
                        </form>
                        {{/if_eq}}

                    </div>
                </li>
            {{/each}}
             <a class="link" href="/discente">Voltar</a>
        </ul>
    </div>
