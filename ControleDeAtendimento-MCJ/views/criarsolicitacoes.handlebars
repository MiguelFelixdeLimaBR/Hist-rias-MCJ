<div class="container form-page">
        <h1>Criar solicitações</h1>
        <form action="/discente/criaslc" method="POST">
            <label for="discente">Nome do discente</label>
            <input type="text" name="discente" id="discente" required>

            <label for="matricula">Matrícula</label>
            <input type="text" name="matricula" id="matricula" required>

            <label for="titulo">Título</label>
            <input type="text" name="titulo" id="titulo" required>

            <label for="causa">Causa</label>
            <input type="text" name="causa" id="causa" required>

            <button type="submit">Enviar</button>
        </form>
        <a class="link" href="/discente">Voltar</a>
    </div>
