<div class="container form-page">
        <h1>Enviar dúvidas</h1>
        <form action="/discente/criarduvida" method="POST">
            <label for="nome">Nome</label>
            <input type="text" id="nome" name="nome" required>

            <label for="duvida">Dúvida</label>
            <textarea id="duvida" name="duvida" rows="4" required></textarea>

            <button type="submit">Enviar dúvida</button>
        </form>
        <a class="link" href="/discente/listarduvidas2">Voltar</a>
    </div>
