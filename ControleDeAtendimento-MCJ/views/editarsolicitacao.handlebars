<div class="container form-page">
        <h1>Editar Solicitação</h1>
        <form action="/slcedit/{{slc.id}}?_method=PUT" method="POST">
            <label for="discente">Discente</label>
            <input type="text" id="discente" name="discente" value="{{slc.discente}}" required>

            <label for="matricula">Matrícula</label>
            <input type="text" id="matricula" name="matricula" value="{{slc.matricula}}" required>

            <label for="titulo">Título</label>
            <input type="text" id="titulo" name="titulo" value="{{slc.titulo}}" required>

            <label for="causa">Causa</label>
            <input type="text" id="causa" name="causa" value="{{slc.causa}}" required>

            <button type="submit">Salvar edição</button>
        </form>
        <a class="link" href="/discente/listarslc">Voltar</a>
    </div>
